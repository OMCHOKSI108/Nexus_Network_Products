# Example environment variables for Nexus Network Products backend
# Copy this file to .env and fill values (DO NOT COMMIT secrets)

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/NexusNetwork?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_strong_random_string

# Email (SMTP)
EMAIL_USER=youremail@example.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_FROM="no-reply@yourdomain.com"
EMAIL_ALLOW_SELF_SIGNED=false

# CORS - comma separated origins (include your frontend URL)
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Cloudinary (optional - preferred for production image hosting)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set these:
# CLOUDNAME=<cloud_name>
# CLOUDNARIY_API=<api_key>
# CLOUDNARIY_SECRET=<api_secret>

# OTP TTL (seconds) - defaults to 300
OTP_TTL_SECONDS=300

# Additional (optional)
# ENABLE_EMAIL_VERIFY=true
