# Frontend Environment Variables
# Public CDN logo (optional) - set to your Cloudinary-hosted logo URL
VITE_CLOUDINARY_LOGO=https://res.cloudinary.com/<cloud_name>/image/upload/v1234567890/your/path/img0.png

VITE_API_URL=http://localhost:5000/api

# For production (Render backend URL), update this after deploying backend
# VITE_API_URL=https://your-backend-app.onrender.com/api
