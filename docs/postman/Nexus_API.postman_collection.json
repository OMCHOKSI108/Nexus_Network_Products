{
  "info": {
    "name": "Nexus Network Products - Full API",
    "_postman_id": "nexus-network-products-full",
    "description": "Collection for testing Nexus Network Products backend. Update the environment `base_url` to point to your deployed server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api (health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api", "host": ["{{base_url}}"], "path": ["api"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/users/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test+{{timestamp}}@example.com\",\n  \"password\": \"test12345\"\n}" },
            "url": { "raw": "{{base_url}}/api/users/register", "host": ["{{base_url}}"], "path": ["api","users","register"] }
          }
        },
        {
          "name": "POST /api/users/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}" },
            "url": { "raw": "{{base_url}}/api/users/login", "host": ["{{base_url}}"], "path": ["api","users","login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  var j = pm.response.json();",
                  "  var token = j.token || (j.data && j.data.token) || j.accessToken || null;",
                  "  if (token) { pm.environment.set('authToken', token); pm.test('Saved authToken', function(){pm.expect(token).to.be.a('string')}); }",
                  "} catch(e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/users/profile (protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{base_url}}/api/users/profile", "host": ["{{base_url}}"], "path": ["api","users","profile"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/products (list)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products?limit=10", "host": ["{{base_url}}"], "path": ["api","products"], "query": [{"key":"limit","value":"10"}] } }
        },
        {
          "name": "GET /api/products/:id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products/{{productId}}", "host": ["{{base_url}}"], "path": ["api","products","{{productId}}"] } }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "GET /api/cart (protected)",
          "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{base_url}}/api/cart", "host": ["{{base_url}}"], "path": ["api","cart"] } }
        },
        {
          "name": "POST /api/cart (add item)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, {"key":"Authorization","value":"Bearer {{authToken}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}" },
            "url": { "raw": "{{base_url}}/api/cart", "host": ["{{base_url}}"], "path": ["api","cart"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /api/orders (create order)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, {"key":"Authorization","value":"Bearer {{authToken}}"}],
            "body": { "mode": "raw", "raw": "{\n  \"cartId\": \"{{cartId}}\",\n  \"shippingAddress\": { \"line1\": \"123 Main\", \"city\": \"City\", \"postalCode\": \"12345\", \"country\": \"Country\" }\n}" },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api","orders"] }
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "POST /api/contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tester\",\n  \"email\": \"tester@example.com\",\n  \"message\": \"Hello from Postman\"\n}" },
            "url": { "raw": "{{base_url}}/api/contact", "host": ["{{base_url}}"], "path": ["api","contact"] }
          }
        }
      ]
    }
  ]
}
