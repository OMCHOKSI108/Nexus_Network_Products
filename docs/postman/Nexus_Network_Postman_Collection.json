{
  "info": {
    "name": "Nexus Network Products API",
    "_postman_id": "27b6a9d2-0001-4f5d-a2c4-8b2f7e9b0c01",
    "description": "Collection for testing Nexus Network Products backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "query": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api"
        }
      }
    },
    {
      "name": "List Products (limit=10)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/products?limit=10"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/products/{{productId}}",
          "variable": [
            { "key": "productId", "value": "" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 404', function () { pm.expect(pm.response.code).to.be.oneOf([200,404]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CORS Preflight (OPTIONS) /api/products",
      "request": {
        "method": "OPTIONS",
        "header": [
          { "key": "Origin", "value": "{{origin}}" },
          { "key": "Access-Control-Request-Method", "value": "GET" },
          { "key": "Access-Control-Request-Headers", "value": "content-type" }
        ],
        "url": {
          "raw": "{{base_url}}/api/products"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204 or 200', function () { pm.expect(pm.response.code).to.be.oneOf([200,204,403,502]); });",
              "pm.test('CORS header present when allowed', function () { if (pm.response.code === 200 || pm.response.code === 204) { pm.response.to.have.header('access-control-allow-origin'); } });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://nexus-network-products.onrender.com" },
    { "key": "origin", "value": "https://nexus-network-products.vercel.app" },
    { "key": "productId", "value": "" }
  ]
}
